{
  "name": "kplgame",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "checkout": "node scripts/checkout-games.mjs",
    "install:games": "node scripts/build-all.mjs --install-only",
    "build": "node scripts/build-all.mjs",
    "collect": "node scripts/collect-games.mjs",
    "validate": "node scripts/validate-build.mjs",
    "release:game": "node scripts/release-game.mjs",
    "test": "node --test tests/*.test.mjs && node scripts/build-all.mjs --test-only",
    "serve": "node scripts/serve.mjs"
  }
}
